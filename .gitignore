# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Claude Code
.claude/

# Node (only if you ever add tooling)
node_modules/
npm-debug.log*

# Cloudflare / Wrangler
.wrangler/
.dev.vars

# Local env
.env
.env.local

# Voice-over outputs (large binaries — track metadata JSON, not MP3s)
scripts/done/*.mp3

# YouTube scorecard OAuth credentials — never commit these
client_secrets.json
.youtube_token.json

# Social proof raw screenshots (may contain personal info — keep local)
proof/raw/*
!proof/raw/.gitkeep
